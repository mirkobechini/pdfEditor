{
  "cli": {
    "version": ">= 21.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "caches": ["npm", "gradle", "maven"]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
