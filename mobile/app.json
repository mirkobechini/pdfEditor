{
  "expo": {
    "name": "PdfEditor",
    "slug": "mobile",
    "version": "0.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mirkobechini.pdfeditor",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PdfEditor to access your camera to scan documents."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-splash-screen",
      "expo-localization",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "b32fb915-ff2f-42ca-81e4-cd311a4602b3"
      },
      "googleClientId": "309361418291-v3j2ccahiqvab4o85ihr9pq6u0u050er.apps.googleusercontent.com"
    }
  }
}
