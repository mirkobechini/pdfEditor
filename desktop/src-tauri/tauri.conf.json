{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PdfEditor",
  "version": "0.1.0",
  "identifier": "com.mirko.pdfeditor",
  "build": {
    "beforeDevCommand": "cd /d ../../frontend && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../../frontend && npm run build",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "PdfEditor",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mirko Bechini",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/fastapi-sidecar"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/mirkobechini/pdfEditor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
