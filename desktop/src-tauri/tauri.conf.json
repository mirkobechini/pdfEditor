{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PdfEditor",
  "version": "0.1.0",
  "identifier": "com.mirko.pdfeditor",
  "build": {
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File ../sync-overlay.ps1 && cd ../../frontend && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File ../sync-overlay.ps1 && cd ../../frontend && npm run build",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "PdfEditor",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/fastapi-sidecar"]
  }
}
