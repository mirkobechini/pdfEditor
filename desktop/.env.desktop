# Desktop sidecar configuration
# This file is bundled with the PyInstaller binary.
# Users can override by placing a .env next to the binary.
# SECRET_KEY and JWT_SECRET_KEY are auto-generated if empty (safe for localhost).
# SUPER_ADMIN_EMAIL is not needed on desktop (SQLite local DB).

ALLOWED_ORIGINS=http://localhost:3000,tauri://localhost,https://tauri.localhost
DATABASE_URL=sqlite:///./pdfeditor.db
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=50
MAX_PAGE_COUNT=500
MAX_SNAPSHOTS=10
ALLOWED_EXTENSIONS=.pdf